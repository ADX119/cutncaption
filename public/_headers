# Cloudflare static-asset response headers. See docs/ARCHITECTURE.md section 4.
# Cross-origin isolation applies to tool routes only.

/tools/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Worker scripts started from an isolated page must carry COEP themselves.
/_next/static/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=31536000, immutable

# Font files carry a content hash in their names; the licence texts beside them never change.
/fonts/*
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Once a browser has loaded the site over HTTPS it will refuse plain HTTP for a year.
  Strict-Transport-Security: max-age=31536000
  # The site may not be embedded in another page (clickjacking).
  X-Frame-Options: DENY
  # Device features the site never uses are switched off outright.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # connect-src is the technical guarantee behind "your file is never uploaded".
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; connect-src 'self' blob: https://cloudflareinsights.com; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
